{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/#contacto", "permanent": true },
    { "source": "/contacto", "destination": "/#contacto", "permanent": true },
    { "source": "/productos/pallets", "destination": "/pallets", "permanent": true },
    { "source": "/productos/tarimas", "destination": "/pallets", "permanent": true },
    { "source": "/productos/flejes", "destination": "/insumos", "permanent": true },
    { "source": "/productos/slip-sheets", "destination": "/palletless", "permanent": true },
    { "source": "/blog/beneficios-pallet-pooling", "destination": "/pooling", "permanent": true },
    { "source": "/productos", "destination": "/#productos", "permanent": true },
    { "source": "/productos/:slug*", "destination": "/#productos", "permanent": true },
    { "source": "/soluciones", "destination": "/#soluciones", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:slug*", "destination": "/", "permanent": true },
    { "source": "/politica-de-privacidad", "destination": "/", "permanent": true },
    { "source": "/cart", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/imgs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/(.*).(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
